# FASTMEM basic functional test
# ==============================
--source include/have_fastmem.inc

--echo # --- basic create / insert / select ---
CREATE TABLE t1 (id INT PRIMARY KEY, v BIGINT NOT NULL, s VARCHAR(32))
  ENGINE=FASTMEM;
INSERT INTO t1 VALUES (1, 100, 'a'), (2, 200, 'bb'), (3, 300, 'ccc');
SELECT * FROM t1 ORDER BY id;
SELECT COUNT(*) FROM t1;

--echo # --- unique key violation ---
--error 1062
INSERT INTO t1 VALUES (1, 999, 'dup');

--echo # --- update in place ---
UPDATE t1 SET v = v + 1 WHERE id = 2;
SELECT * FROM t1 WHERE id = 2;

--echo # --- key changing update ---
UPDATE t1 SET id = id + 100 WHERE id < 3;
SELECT * FROM t1 ORDER BY id;

--echo # --- delete ---
DELETE FROM t1 WHERE id = 103;
SELECT COUNT(*) FROM t1;

--echo # --- non-unique secondary key ---
CREATE TABLE t2 (id INT PRIMARY KEY, k INT NOT NULL, KEY k1 (k))
  ENGINE=FASTMEM;
INSERT INTO t2 VALUES (1, 10), (2, 10), (3, 20), (4, 20), (5, 20);
SELECT id, k FROM t2 WHERE k = 20 ORDER BY id;

--echo # --- auto_increment ---
CREATE TABLE t3 (id INT NOT NULL AUTO_INCREMENT PRIMARY KEY, v INT)
  ENGINE=FASTMEM;
INSERT INTO t3 (v) VALUES (1), (2), (3);
SELECT * FROM t3;
INSERT INTO t3 (v) VALUES (4);
SELECT LAST_INSERT_ID();
SHOW CREATE TABLE t3;

--echo # --- truncate ---
TRUNCATE TABLE t3;
SELECT COUNT(*) FROM t3;
INSERT INTO t3 (v) VALUES (10);
SELECT * FROM t3;

--echo # --- btrees are rejected ---
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE t_btree (id INT PRIMARY KEY USING BTREE) ENGINE=FASTMEM;

--echo # --- memory size limit honored (health check) ---
SET SESSION max_heap_table_size = 65536;
CREATE TABLE t_small (a INT PRIMARY KEY, b VARCHAR(100)) ENGINE=FASTMEM;
--echo # do not fill to the limit in the test; just verify it exists
SELECT 1;

--echo # --- join / index usage smoke ---
SELECT t1.id, t2.k FROM t1 JOIN t2 ON t1.id = t2.id ORDER BY t1.id;
EXPLAIN SELECT * FROM t2 WHERE k = 10;

--echo # --- cleanup ---
DROP TABLE t1, t2, t3, t_small;
DROP TABLE IF EXISTS t_btree;

--echo # --- done ---